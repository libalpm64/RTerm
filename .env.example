# RTerm Environment Variables for Testing
# Copy this file to .env and fill in your values (never commit .env!)

# SSH Test Server
RTEST_SSH_HOST=your-server-ip-or-hostname
RTEST_SSH_PORT=22
RTEST_SSH_USER=your-username
RTEST_SSH_PASS=your-password
# Or use key-based auth:
# RTEST_SSH_KEY_PATH=/path/to/private/key

# Telnet Test Server (optional)
RTEST_TELNET_HOST=your-telnet-server
RTEST_TELNET_PORT=23
